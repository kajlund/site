{% extends "layout.njk" %}

{% block head %}
  <link rel="stylesheet" href="/css/profile.css">
{% endblock %}

{% block content %}
<div class="container">

<div class="profile-page">
  <form action="/auth/profile/update" method="POST" class="profile-card">
    <header class="profile-header">
      <h2>Edit Profile</h2>
    </header>

    <div class="form-grid">
      <div class="form-group">
        <label>Alias</label>
        <input type="text" name="alias" value="{{ profile.alias }}" required>
      </div>

      <div class="form-group">
        <label>Avatar URL (Optional)</label>
        <input type="url" name="avatar" value="{{ profile.avatar }}" placeholder="https://...">
        <small>Leave blank to use Gravatar based on your email.</small>
      </div>

      <hr class="form-divider">

      <div class="readonly-section">
        <div class="info-bit">
          <label>Email</label>
          <span>{{ profile.email }}</span>
        </div>
        <div class="info-bit">
          <label>Account Role</label>
          <span>{{ profile.role | upper }}</span>
        </div>
        <div class="info-bit">
          <label>Member Since</label>
          <span>{{ profile.createdAt | date }}</span>
        </div>
        <div class="info-bit">
          <label>Last Updated</label>
          <span>{{ profile.updatedAt | date }}</span>
        </div>
      </div>
    </div>

    <div class="actions">
      <button type="submit" class="btn-primary">Save Changes</button>
      <a href="/auth/profile" class="btn-text">Cancel</a>
    </div>
  </form>
</div>
</div>
{% endblock %}
